# Application
web/app/plugins/*
!web/app/plugins/.gitkeep
# Ignore Composer-installed mu-plugin directories; single-file mu-plugins are tracked intentionally
web/app/mu-plugins/*/
web/app/upgrade
web/app/uploads/*
!web/app/uploads/.gitkeep
web/app/cache/*
web/app/languages
# Breeze runtime cache files are generated separately for each environment.
/web/app/advanced-cache.php
/web/app/breeze-config/
# Generated by Query Monitor during local activation
/web/app/db.php

# WordPress
web/wp
web/.htaccess

# Logs
*.log

# Dotenv
.env
.env.*
!.env.example

# Composer
/vendor
auth.json

# PHPUnit/Pest
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# WP-CLI
wp-cli.local.yml

web/app/themes/*
!web/app/themes/.gitkeep
composer.local.json
composer.local.lock
.docker/
.local/
/backups/
/dist/
.DS_Store
