<?xml version="1.0"?><ruleset name="Bedrock"><description>PSR-12 for upstream Bedrock configuration; packages use WPCS.</description><file>config</file><file>web/index.php</file><file>web/wp-config.php</file><rule ref="PSR12"><exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/></rule><exclude-pattern>web/wp/*</exclude-pattern><rule ref="Generic.Files.LineLength"><properties><property name="lineLimit" value="180"/></properties></rule></ruleset>